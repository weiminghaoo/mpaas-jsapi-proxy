.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-row, .status-row {
  display: flex;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.value {
  font-size: 26rpx;
  color: #1890ff;
  flex: 1;
}

.hint {
  font-size: 22rpx;
  color: #999;
}

.status {
  font-size: 28rpx;
  font-weight: bold;
}

.status.connected {
  color: #52c41a;
}

.status.disconnected {
  color: #999;
}

.status.connecting, .status.error {
  color: #faad14;
}

.input-row {
  margin-bottom: 20rpx;
}

.server-input {
  width: 100%;
  padding: 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.button-row {
  display: flex;
  gap: 20rpx;
}

.btn-primary, .btn-secondary {
  flex: 1;
}

.btn-primary {
  background-color: #1890ff;
  color: white;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #333;
}

.footer {
  text-align: center;
  padding: 40rpx 0;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
}

/* 扫码按钮样式 */
.input-row-scan {
  display: flex;
  align-items: center;
  position: relative;
  margin-bottom: 20rpx;
}

.input-row-scan .server-input {
  padding-right: 60rpx;
}

.scan-icon {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  right: 16rpx;
}

/* 代码块样式 */
.code-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f6f6f6;
  border: 1px solid #e8e8e8;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 10rpx;
}

.code-text {
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.copy-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.5;
}

/* 代码预览样式 */
.code-preview {
  background-color: #f6f6f6;
  border: 1px solid #e8e8e8;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-top: 10rpx;
  text-align: center;
}

.code-preview-text {
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}
