<view class="container">
  <view class="header">
    <text class="title">mPaaS JSAPI 代理</text>
  </view>

  <view class="card">
    <view class="card-title">设备信息</view>
    <view class="info-row">
      <text class="label">设备ID：</text>
      <text class="value">{{deviceId}}</text>
    </view>
    <view class="button-row" style="margin-top: 20rpx;">
      <button class="btn-secondary" onTap="copyConnectionParams" style="width: 100%;">复制连接参数</button>
    </view>
  </view>

  <view class="card">
    <view class="card-title">连接状态</view>
    <view class="status-row">
      <text class="label">状态：</text>
      <text class="status {{statusClass}}">{{connectionStatus}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">服务器配置</view>
    <view class="input-row-scan">
      <input
        class="server-input"
        placeholder="ws://192.168.1.100:3000"
        value="{{serverUrl}}"
        onInput="onServerUrlInput"
      />
      <image class="scan-icon" src="{{scanIcon}}" onTap="scanQRCode" />
    </view>
    <view class="button-row">
      <button a:if="{{!isConnected}}" class="btn-primary" onTap="connect">连接</button>
      <button a:if="{{isConnected}}" class="btn-secondary" onTap="disconnect">断开</button>
    </view>
  </view>

  <view class="card">
    <view class="card-title">使用说明</view>
    <view class="info-row">
      <text class="label">1. 全局安装：</text>
    </view>
    <view class="code-block" onTap="copyInstallCommand">
      <text class="code-text">npm install -g mpaas-jsapi-proxy</text>
      <image class="copy-icon" src="/assets/copy.svg" />
    </view>
    <view class="info-row" style="margin-top: 10rpx;">
      <text class="label">2. 启动服务器：</text>
    </view>
    <view class="code-block" onTap="copyStartCommand">
      <text class="code-text">mpaas-jsapi-proxy</text>
      <image class="copy-icon" src="/assets/copy.svg" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">客户端代理代码</view>
    <view class="info-row">
      <text class="label">将以下代码复制到模拟器的调试工具中：</text>
    </view>
    <view class="code-preview">
      <text class="code-preview-text">class MyCallProxy { ... }</text>
    </view>
    <view class="button-row" style="margin-top: 20rpx;">
      <button class="btn-primary" onTap="copyClientProxyCode">复制完整代码</button>
    </view>
  </view>

  <view class="footer">
    <text class="hint-text">连接成功后，点击"复制连接参数"，然后粘贴到模拟器的 MyCallProxy 中</text>
  </view>
</view>
