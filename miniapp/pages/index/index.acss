.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 24rpx 0 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.h-1 {
  height: 1px;
}

.flex-1 {
  flex: 1;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.justify-between {
  justify-content: space-between;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.card-title-desc {
  font-size: 24rpx;
  color: #999;
}

.info-row {
  display: flex;
  align-items: center;
}

/* 卡片内多行信息之间的分隔 */
.info-row.divider {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.value {
  font-size: 26rpx;
  color: #1890ff;
  flex: 1;
}

.hint {
  font-size: 22rpx;
  color: #999;
}

.status {
  font-size: 28rpx;
  font-weight: bold;
}

.status.connected {
  color: #52c41a;
}

.status.disconnected {
  color: #999;
}

.status.connecting,
.status.error {
  color: #faad14;
}

.input-row {
  margin-bottom: 20rpx;
}

.server-input {
  width: 100%;
  padding: 20rpx;
  border: 1px solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.button-row {
  display: flex;
  gap: 20rpx;
}

.btn-primary,
.btn-secondary {
  flex: 1;
}

.btn-primary {
  background-color: #1890ff;
  color: white;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #333;
}

.footer {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #999;
}

/* 扫码按钮样式 */
.input-row-scan {
  display: flex;
  align-items: center;
  position: relative;
  margin-bottom: 20rpx;
}

.input-row-scan .server-input {
  padding-right: 60rpx;
}

.scan-icon {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  right: 16rpx;
}

/* 小节标签（卡片内分组标题） */
.section-label {
  font-size: 24rpx;
  color: #999;
  margin: 20rpx 0 8rpx;
}

.card-title+.section-label {
  margin-top: 0;
}

/* 代码块样式 */
.code-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f6f6f6;
  border: 1px solid #e8e8e8;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-top: 8rpx;
}

.code-block+.code-block {
  margin-top: 12rpx;
}

.code-text {
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  color: #333;
  flex: 1;
  white-space: pre-wrap;
  word-break: break-all;
}

.copy-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.5;
}

/* 代码预览样式 */
.code-preview {
  background-color: #f6f6f6;
  border: 1px solid #e8e8e8;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-top: 10rpx;
  text-align: center;
}

.code-preview-text {
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 运行日志 */
.log-actions {
  margin-bottom: 12rpx;
}

.btn-mini {
  font-size: 22rpx;
  padding: 0 20rpx;
  height: 48rpx;
  margin: 0;
  background-color: #f5f5f5;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
}

.log-list {
  overflow-y: scroll;
}

.log-item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.log-time {
  font-size: 20rpx;
  color: #bbb;
  margin-right: 10rpx;
}

.log-tag {
  font-size: 22rpx;
  color: #1890ff;
  margin-right: 10rpx;
}

.log-copy {
  font-size: 22rpx;
  color: #1890ff;
}

.log-text {
  font-size: 22rpx;
  color: #666;
  word-break: break-all;
  display: block;
  margin-top: 4rpx;
}

.log-empty {
  text-align: center;
  padding: 24rpx 0;
}

/* 使用说明 popup */
.popup-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup {
  width: 86%;
  max-height: 80vh;
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-close {
  font-size: 44rpx;
  color: #999;
  padding: 0 12rpx;
  line-height: 1;
}

.popup-body {
  max-height: 64vh;
  overflow-y: scroll;
}