.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 24rpx 0 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.ipt {
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  margin: 0;
  flex: 1;
  min-width: 180rpx;
}

.btn.small {
  flex: none;
  min-width: 140rpx;
}

.log-list {
  max-height: 60vh;
  overflow-y: scroll;
}

.log-item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.log-time {
  font-size: 20rpx;
  color: #bbb;
  margin-right: 10rpx;
}

.log-tag {
  font-size: 22rpx;
  color: #1890ff;
  margin-right: 10rpx;
}

.log-text {
  font-size: 22rpx;
  color: #666;
  word-break: break-all;
  display: block;
  margin-top: 4rpx;
}

.log-empty {
  text-align: center;
  padding: 24rpx 0;
}
